# ==============================================================================
# NagariSDLC — Template Environment Frontend (produksi)
# ==============================================================================
# Salin menjadi `.env.production` di mesin build, lalu jalankan `npm run build`.
# Vite membaca `.env.production` otomatis untuk mode production.
#
# PENTING: seluruh nilai berawalan `VITE_` ikut dibundel ke berkas JavaScript
# hasil build dan bersifat publik. Jangan menaruh rahasia di sini.
#
# `VITE_API_URL` menunjuk ke host backend dan wajib memakai HTTPS. Sebaliknya,
# host tempat frontend ini disajikan harus terdaftar pada `CORS_ALLOWED_ORIGINS`
# di `.env` backend, jika tidak browser akan memblokir seluruh request API.
# ==============================================================================

VITE_API_URL=https://<host-api-produksi>/api/v1
VITE_STAGING_URL=https://<host-staging>

# Masa berlaku token akses dalam menit. WAJIB sama dengan
# `SANCTUM_TOKEN_EXPIRATION` pada `.env` backend (default backend 480 = 8 jam).
VITE_TOKEN_EXPIRY_MINUTES=480

