# ==============================================================================
# NagariSDLC — Template Environment Frontend (pengembangan lokal)
# ==============================================================================
# Salin menjadi `.env`, lalu sesuaikan bila port backend berbeda.
#
# PENTING: seluruh nilai berawalan `VITE_` ikut dibundel ke dalam berkas
# JavaScript hasil build dan dapat dibaca siapa pun yang membuka aplikasi.
# Jangan pernah menaruh token, password, atau kunci rahasia di sini.
# ==============================================================================

# Base URL REST API backend, termasuk prefix versi.
VITE_API_URL=http://localhost:8000/api/v1

# URL environment staging, dipakai sebagai placeholder pada Tahap 1 SIT.
VITE_STAGING_URL=https://staging-app.banknagari.co.id

# Masa berlaku token akses dalam menit. WAJIB sama dengan
# `SANCTUM_TOKEN_EXPIRATION` pada `.env` backend (default backend 480 = 8 jam).
# Nilai ini dipakai frontend untuk menyegarkan token beberapa menit sebelum
# kedaluwarsa; bila berbeda dari backend, pengguna bisa terlempar ke halaman
# masuk di tengah pekerjaan. Boleh dikosongkan untuk memakai default 480.
VITE_TOKEN_EXPIRY_MINUTES=480

# Catatan: `VITE_API_MODE` masih ada pada sebagian berkas `.env` lama, tetapi
# tidak dibaca kode mana pun sekarang. Boleh dihapus.
