# ==============================================================================
# NagariSDLC — Template Environment Produksi (backend)
# ==============================================================================
# Salin berkas ini menjadi `.env` di server produksi, lalu isi setiap nilai
# bertanda <...>. Jangan pernah commit `.env` yang sudah terisi.
#
# Langkah setelah mengisi:
#   php artisan key:generate            # hanya sekali, saat APP_KEY masih kosong
#   php artisan migrate --force
#   php artisan storage:link
#   php artisan config:cache
#   php artisan route:cache
#   php artisan event:cache
#
# Catatan: `config:cache` membekukan nilai env. Setiap kali `.env` berubah,
# jalankan ulang `php artisan config:cache`.
# ==============================================================================

# --- Aplikasi -----------------------------------------------------------------
APP_NAME="NagariSDLC"
APP_ENV=production
# Dihasilkan oleh `php artisan key:generate`. Wajib terisi.
APP_KEY=
# WAJIB false di produksi. `true` membocorkan stack trace, query, dan nilai env.
APP_DEBUG=false
# URL publik backend, tanpa garis miring di akhir.
APP_URL=https://<host-api-produksi>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
# Catatan: aplikasi belum punya berkas terjemahan (`lang/` tidak ada), sehingga
# APP_LOCALE dibiarkan `en`. Pesan UI berbahasa Indonesia ditulis di frontend.
# Timezone tidak dibaca dari env oleh Laravel; ubah di config/app.php bila perlu.

# Biaya hashing password. 12 aman untuk produksi.
BCRYPT_ROUNDS=12

# --- Frontend & CORS ----------------------------------------------------------
# URL SPA React. Dipakai sebagai fallback origin CORS.
FRONTEND_URL=https://<host-frontend-produksi>
# Daftar origin yang boleh mengakses API, dipisah koma, tanpa spasi berlebih.
# Wildcard `*` dilarang di produksi dan otomatis dibuang oleh config/cors.php.
CORS_ALLOWED_ORIGINS=https://<host-frontend-produksi>

# --- Autentikasi (Sanctum) ----------------------------------------------------
# Masa berlaku token dalam menit. 480 = 8 jam, sesuai perilaku refresh frontend.
# Frontend membaca angka ini dari respons login/refresh
# (`data.token_expires_in_minutes`), jadi tidak perlu lagi disamakan manual dengan
# `VITE_TOKEN_EXPIRY_MINUTES` — variabel itu kini hanya cadangan.
SANCTUM_TOKEN_EXPIRATION=480
# Hanya diperlukan bila memakai autentikasi sesi/cookie Laravel (statefulApi()).
# Aplikasi ini memakai token Sanctum — dibawa cookie `HttpOnly` di bawah, atau
# header Bearer untuk klien non-peramban — jadi biarkan baris ini dikomentari.
# SANCTUM_STATEFUL_DOMAINS=

# --- Cookie sesi API (config/auth_cookie.php) ---------------------------------
# Token Sanctum dikirim sebagai cookie `HttpOnly` supaya tidak dapat dibaca
# JavaScript. Nilai di bawah adalah setelan produksi yang dimaksudkan.
AUTH_COOKIE_NAME=nagari_sdlc_token
# Kosong = mengikuti SANCTUM_TOKEN_EXPIRATION.
AUTH_COOKIE_LIFETIME=
# Isi HANYA bila SPA dan API berada di subdomain berbeda dari satu domain induk,
# mis. `.banknagari.co.id`. Bila keduanya satu host, biarkan kosong — cookie akan
# terkunci pada host penerbitnya.
AUTH_COOKIE_DOMAIN=
# Wajib true: `false` membuat token melintas sebagai teks polos tanpa pesan error.
AUTH_COOKIE_SECURE=true
# `lax` bila SPA dan API berbagi domain induk. Pakai `none` hanya bila domainnya
# benar-benar berbeda; `none` mewajibkan AUTH_COOKIE_SECURE=true dan backend
# menolak kombinasi yang salah alih-alih membiarkan cookienya dibuang peramban.
AUTH_COOKIE_SAME_SITE=lax
# Penangkal CSRF. Harus sama dengan yang dikirim frontend/src/services/api.js.
AUTH_COOKIE_REQUIRED_HEADER=X-Requested-With
# false di produksi: token tidak pernah melewati JavaScript, sehingga skrip yang
# disuntikkan ke SPA tidak dapat memanggil `POST /auth/refresh` lalu membaca token
# baru dari body respons. Setel true HANYA bila ada klien non-peramban (Postman,
# integrasi internal) yang masih membaca `data.token`.
AUTH_COOKIE_EXPOSE_TOKEN=false

# --- Log ----------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` terlalu berisik dan berisiko membocorkan data di produksi.
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# --- Database -----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=<host-db>
DB_PORT=3306
DB_DATABASE=<nama-db>
DB_USERNAME=<user-db>
DB_PASSWORD=<password-db>

# --- Session, Cache, Queue ----------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true agar cookie hanya dikirim lewat HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
# Isi bila beberapa aplikasi berbagi satu cache store.
CACHE_PREFIX=

# Queue database memerlukan worker berjalan sebagai service:
#   php artisan queue:work --queue=default --tries=3 --timeout=120
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

# --- Penyimpanan berkas -------------------------------------------------------
# `local` menyimpan dokumen di storage/app. Pastikan direktori ini ikut dibackup
# dan tidak ikut terhapus saat deploy ulang.
FILESYSTEM_DISK=local

# --- Broadcast / Realtime (Reverb) --------------------------------------------
# `log` berarti event hanya ditulis ke log dan frontend bergantung pada polling.
# Ubah ke `reverb` bila server WebSocket sudah dijalankan.
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=<host-reverb>
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Email --------------------------------------------------------------------
# WAJIB `smtp` di produksi. Reset password (`POST /auth/forgot-password`) mengirim
# tautan lewat email; dengan `log`, tautannya hanya tertulis di
# `storage/logs/laravel.log` dan pengguna tidak pernah menerimanya.
# Notifikasi dalam aplikasi tetap tersimpan di tabel `notifications`, dan link
# approval eksternal UAT masih dibagikan manual oleh PM — keduanya tidak butuh SMTP.
MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS=no-reply@banknagari.co.id
MAIL_FROM_NAME="${APP_NAME}"

# --- Redis (opsional) ---------------------------------------------------------
# Diisi hanya bila CACHE_STORE / QUEUE_CONNECTION diubah ke redis.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- AWS S3 (opsional) --------------------------------------------------------
# Diisi hanya bila FILESYSTEM_DISK diubah ke s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================================================
# Checklist sebelum go-live
# ==============================================================================
# [ ] APP_DEBUG=false dan APP_ENV=production
# [ ] APP_KEY terisi dan dibackup di tempat aman
# [ ] UAT_PHONE_HASH_KEY terisi dan dibackup terpisah dari APP_KEY (merotasinya
#     membatalkan seluruh phone_hash approver eksternal yang sudah tersimpan)
# [ ] CORS_ALLOWED_ORIGINS berisi host frontend saja, tanpa `*`
# [ ] AUTH_COOKIE_SECURE=true dan AUTH_COOKIE_EXPOSE_TOKEN=false
# [ ] AUTH_COOKIE_SAME_SITE sesuai penempatan: `lax` bila SPA dan API satu domain
#     induk, `none` bila benar-benar beda domain (dan `none` wajib bersama secure)
# [ ] HTTPS aktif di frontend dan backend
# [ ] User DB produksi bukan root dan hanya punya hak pada satu database
# [ ] `php artisan migrate --force` sudah dijalankan pada database produksi
# [ ] Worker queue berjalan sebagai service
# [ ] Scheduler terpasang bila ada job periodik:
#     * * * * * cd /path/backend && php artisan schedule:run >> /dev/null 2>&1
# [ ] Backup terjadwal untuk database dan storage/app/documents
# [ ] Permission storage/ dan bootstrap/cache/ dapat ditulis web server
# ==============================================================================
