APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# URL SPA React dan daftar origin yang boleh mengakses API (dipisah koma).
# Saat APP_ENV=local, origin dev server Vite otomatis diizinkan oleh
# config/cors.php sehingga CORS_ALLOWED_ORIGINS boleh dibiarkan kosong.
# FRONTEND_URL juga menjadi basis tautan reset password
# (`{FRONTEND_URL}/reset-password?token=...&email=...`), jadi nilainya harus
# menunjuk SPA yang benar-benar dipakai.
# Untuk staging/produksi lihat .env.production.example.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Masa berlaku token Sanctum dalam menit (480 = 8 jam).
# Frontend tidak perlu lagi disetel manual ke nilai yang sama: respons login/refresh
# mengembalikan `data.token_expires_in_minutes`, dan itulah yang dipakai SPA untuk
# menjadwalkan penyegaran. `VITE_TOKEN_EXPIRY_MINUTES` di `.env` frontend tinggal
# menjadi cadangan untuk sesi lama yang tersimpan sebelum kunci tersebut ada.
SANCTUM_TOKEN_EXPIRATION=480

# ── Cookie sesi API (config/auth_cookie.php) ───────────────────────────────────
# Token Sanctum dikirim sebagai cookie `HttpOnly` sehingga tidak dapat dibaca
# JavaScript. Header `Authorization: Bearer` tetap didukung untuk klien non-peramban.
#
# Nama cookie. Ubah hanya bila bentrok dengan aplikasi lain pada domain yang sama.
AUTH_COOKIE_NAME=nagari_sdlc_token
#
# Masa berlaku cookie (menit). Dibiarkan kosong: mengikuti SANCTUM_TOKEN_EXPIRATION.
# Jangan disetel lebih panjang daripada masa berlaku token — cookie yang tersisa
# setelah tokennya mati hanya menghasilkan 401 berulang tanpa sebab yang terlihat.
AUTH_COOKIE_LIFETIME=
#
# Domain cookie. Kosongkan untuk mengunci cookie pada host yang menerbitkannya.
# Isi dengan domain induk (mis. `.banknagari.co.id`) HANYA bila SPA dan API benar-benar
# berada di subdomain berbeda. Setiap penambahan di sini memperluas daftar host yang
# menerima token, jadi jangan diisi "untuk berjaga-jaga".
AUTH_COOKIE_DOMAIN=
#
# Kirim cookie hanya lewat HTTPS. Dibiarkan kosong: `true` kecuali APP_ENV=local.
# Di produksi nilainya HARUS true — `false` membuat token melintas sebagai teks polos
# tanpa satu pun pesan error.
AUTH_COOKIE_SECURE=
#
# Kebijakan SameSite: `lax` cukup bila SPA dan API berbagi domain induk. Pakai `none`
# hanya bila domainnya benar-benar berbeda, dan `none` MEWAJIBKAN AUTH_COOKIE_SECURE=true
# (kombinasi `none` + secure=false ditolak backend, bukan dibiarkan gagal diam-diam).
AUTH_COOKIE_SAME_SITE=lax
#
# Header yang wajib menyertai permintaan berbasis cookie sebagai penangkal CSRF.
# Harus sama dengan nilai yang dikirim `frontend/src/services/api.js`. Jangan diubah
# tanpa mengubah frontend — permintaan SPA akan dijawab 400.
AUTH_COOKIE_REQUIRED_HEADER=X-Requested-With
#
# Sertakan token pada body respons login/refresh.
#
# SETEL `false` DI PRODUKSI. Selama `true`, manfaat cookie `HttpOnly` belum utuh:
# skrip yang berhasil disuntikkan ke SPA dapat memanggil `POST /auth/refresh` —
# cookienya ikut terkirim otomatis — lalu membaca token baru dari body respons.
#
# Default `true` demi kompatibilitas klien non-peramban (Postman, alat internal) dan
# pengujian otomatis yang masih membaca `data.token`. SPA sendiri tidak lagi
# membutuhkannya. Mematikannya adalah perubahan kontrak API yang terlihat klien lain.
AUTH_COOKIE_EXPOSE_TOKEN=true

# Kunci HMAC untuk `uat_approvers.phone_hash` — hash nomor HP approver UAT
# eksternal yang dipakai memverifikasi pemilik link persetujuan.
#
# PERINGATAN: mengubah nilai ini membatalkan SELURUH `phone_hash` yang sudah
# tersimpan. Approver eksternal yang link-nya masih berjalan akan gagal verifikasi
# tanpa pesan yang menunjuk penyebabnya, dan PM harus membuat putaran/link baru.
# Perlakukan seperti kunci kriptografi: setel sekali per lingkungan, jangan dirotasi
# bersama `APP_KEY`.
#
# Dibiarkan kosong: kunci jatuh kembali ke `APP_KEY` supaya hash lama — yang dulu
# memang dihitung dengan `APP_KEY` — tetap dapat diverifikasi. Deployment lama tidak
# perlu menyetel apa pun. Isi variabel ini hanya pada lingkungan baru, atau setelah
# seluruh link approval eksternal yang berjalan selesai/dibuat ulang.
UAT_PHONE_HASH_KEY=

# Batas percobaan verifikasi nomor HP pada link approval eksternal, dan lama kunci
# (menit) setelah batas itu terlampaui. Penghitung percobaan hanya direset oleh
# verifikasi yang berhasil atau setelah masa kunci benar-benar habis.
UAT_VERIFICATION_MAX_ATTEMPTS=5
UAT_VERIFICATION_LOCKOUT_MINUTES=15

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` cukup untuk pengembangan lokal: email reset password tidak dikirim,
# isinya ditulis ke storage/logs/laravel.log sehingga tautannya bisa dicopy dari
# sana untuk pengujian. Produksi wajib `smtp` — lihat .env.production.example.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
